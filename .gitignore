# Source archives: their extracted form lives under Assets/ThirdParty/, so the zips
# would only duplicate it in history.
Assets/*.zip
Assets/*.zip.meta

# ThirdParty is tracked -- the scenes reference its FBX, materials and textures.
# These two are the heavy parts Unity never imports: UE5-format source textures
# (422 MB) and the Blender source the FBX were exported from.
Assets/ThirdParty/MadduckHospital/Hospital_assets/UE5_textures/
Assets/ThirdParty/MadduckHospital/Hospital_assets/UE5_textures.meta
Assets/ThirdParty/MadduckHospital/Hospital_assets/hospital.blend
Assets/ThirdParty/MadduckHospital/Hospital_assets/hospital.blend.meta

# Build output
cpr_v0.7/
*_BurstDebugInformation_DoNotShip/

# Agent tooling
.codex/

# Editor verification screenshots (generated, unreferenced by any scene)
Assets/Screenshots/
Assets/Screenshots.meta

